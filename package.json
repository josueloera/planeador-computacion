{
  "name": "app---planeador-computacion",
  "version": "1.0.0",
  "description": "Planeador Computacion App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.sep.planeadorcomputacion",
    "productName": "Planeador Computacion",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null
    }
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^43.4.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "node-machine-id": "^1.1.12"
  },
  "overrides": {
    "@noble/hashes": "1.3.2"
  }
}